      <span class=sf-dump-str title=\"10012 characters\">&lt;td class=&quot;cOeeGf&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;Protects internal electrical systems from over-voltages (transients) caused by various sources, including indirect lightning and switching operations.&lt;/td&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
