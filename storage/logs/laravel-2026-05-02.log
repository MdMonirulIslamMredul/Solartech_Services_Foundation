      <span class=sf-dump-str title=\"10012 characters\">&lt;td class=&quot;cOeeGf&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;Installed within the electrical system, such as at the main service entrance, in circuit breaker panels, or near sensitive equipment terminals.&lt;/td&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
