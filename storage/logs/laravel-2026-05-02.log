    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>4</span>
    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"18 characters\">Lightning Arrester</span>\"
    \"<span class=sf-dump-key>banner</span>\" => \"<span class=sf-dump-str title=\"20 characters\">1763824923banner.png</span>\"
    \"<span class=sf-dump-key>image1</span>\" => \"<span class=sf-dump-str title=\"20 characters\">1763824402image1.png</span>\"
    \"<span class=sf-dump-key>image2</span>\" => <span class=sf-dump-const>null</span>
    \"<span class=sf-dump-key>image3</span>\" => <span class=sf-dump-const>null</span>
    \"<span class=sf-dump-key>is_active</span>\" => <span class=sf-dump-num>1</span>
    \"<span class=sf-dump-key>details1</span>\" => \"<span class=sf-dump-str title=\"808 characters\">&lt;p&gt;A&amp;nbsp;&lt;strong class=&quot;Yjhzub&quot; data-complete=&quot;true&quot; data-processed=&quot;true&quot;&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot; data-processed=&quot;true&quot;&gt;lightning arrester&lt;/span&gt;&lt;/strong&gt;&amp;nbsp;is&amp;nbsp;&lt;mark class=&quot;HxTRcb&quot; data-complete=&quot;true&quot; data-sae=&quot;&quot;&gt;a protective device used in electrical power and telecommunications systems to safeguard insulation and conductors from the damaging effects of high-voltage surges, primarily those caused by lightning strikes&lt;/mark&gt;. It works by providing a low-resistance path to the ground for the excess current, thereby diverting it away from sensitive equipment.&lt;span class=&quot;uJ19be notranslate&quot; data-wiz-uids=&quot;JQ2klf_g,JQ2klf_h,JQ2klf_i&quot; data-complete=&quot;true&quot; data-processed=&quot;true&quot;&gt;&lt;span class=&quot;vKEkVd&quot; data-animation-atomic=&quot;&quot; data-sae=&quot;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</span>\"
    \"<span class=sf-dump-key>details2</span>\" => \"\"\"
      <span class=sf-dump-str title=\"1052 characters\">&lt;div class=&quot;AdPoic&quot; role=&quot;heading&quot; aria-level=&quot;3&quot; data-animation-nesting=&quot;&quot; data-sfc-cp=&quot;&quot; data-processed=&quot;true&quot; data-sae=&quot;&quot; data-complete=&quot;true&quot;&gt;How It Works&lt;button class=&quot;rBl3me&quot; tabindex=&quot;0&quot; data-amic=&quot;true&quot; data-icl-uuid=&quot;a8de0a94-cf7c-45f1-a53a-da5a27130c61&quot; aria-label=&quot;View related links&quot; data-wiz-attrbind=&quot;disabled=JQ2klf_p_C5gNJc;class=JQ2klf_p_UpSNec;&quot; data-ved=&quot;2ahUKEwjGxP_lhYaRAxWmXWwGHQmOON4Qye0OegQIAxAA&quot;&gt;&lt;/button&gt;&lt;/div&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1052 characters\">&lt;div class=&quot;Y3BBE&quot; data-sfc-cp=&quot;&quot; data-hveid=&quot;CAQQAA&quot; data-complete=&quot;true&quot; data-processed=&quot;true&quot;&gt;Under normal operating conditions, a lightning arrester acts as an insulator, and no current flows through it. When a high-voltage surge (transient overvoltage) occurs due to a lightning strike, the material inside the arrester breaks down and becomes highly conductive. This channels the surge current safely to the earth via a ground wire. Once the voltage returns to normal levels, the arrester restores its high-resistance state, preventing the continued flow of normal power frequency current to the ground&lt;/div&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>details3</span>\" => \"\"\"
      <span class=sf-dump-str title=\"10012 characters\">&lt;div class=&quot;AdPoic&quot; role=&quot;heading&quot; aria-level=&quot;3&quot; data-animation-nesting=&quot;&quot; data-sfc-cp=&quot;&quot; data-processed=&quot;true&quot; data-sae=&quot;&quot; data-complete=&quot;true&quot;&gt;Key Functions and Uses&lt;button class=&quot;rBl3me&quot; tabindex=&quot;0&quot; data-amic=&quot;true&quot; data-icl-uuid=&quot;9e376b1d-ccc7-42fe-8972-7687d8df8e88&quot; aria-label=&quot;View related links&quot; data-wiz-attrbind=&quot;disabled=JQ2klf_1q_C5gNJc;class=JQ2klf_1q_UpSNec;&quot; data-ved=&quot;2ahUKEwjGxP_lhYaRAxWmXWwGHQmOON4Qye0OegQIBhAA&quot;&gt;&lt;/button&gt;&lt;/div&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"10012 characters\">&lt;ul class=&quot;KsbFXc U6u95&quot; data-complete=&quot;true&quot; data-processed=&quot;true&quot;&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"10012 characters\">&lt;li data-hveid=&quot;CAcQAA&quot; data-complete=&quot;true&quot; data-sae=&quot;&quot;&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;&lt;strong class=&quot;Yjhzub&quot; data-complete=&quot;true&quot;&gt;Equipment Protection&lt;/strong&gt;: Prevents severe damage to expensive electrical equipment like transformers, circuit breakers, generators, and sensitive electronic devices.&lt;/span&gt;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"10012 characters\">&lt;li data-hveid=&quot;CAcQAQ&quot; data-complete=&quot;true&quot; data-sae=&quot;&quot;&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;&lt;strong class=&quot;Yjhzub&quot; data-complete=&quot;true&quot;&gt;Safety&lt;/strong&gt;: Mitigates the risk of electrical fires, explosions, and electric shocks to people and animals by safely grounding the massive electrical energy.&lt;/span&gt;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"10012 characters\">&lt;li data-hveid=&quot;CAcQAg&quot; data-complete=&quot;true&quot; data-sae=&quot;&quot;&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;&lt;strong class=&quot;Yjhzub&quot; data-complete=&quot;true&quot;&gt;System Reliability&lt;/strong&gt;: Ensures the continuous operation and integrity of power systems and communication networks by avoiding unexpected downtime caused by lightning damage.&lt;/span&gt;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"10012 characters\">&lt;li data-hveid=&quot;CAcQAw&quot; data-complete=&quot;true&quot; data-sae=&quot;&quot;&gt;&lt;span class=&quot;T286Pc&quot; data-sfc-cp=&quot;&quot; data-complete=&quot;true&quot;&gt;&lt;strong class=&quot;Yjhzub&quot; data-complete=&quot;true&quot;&gt;Versatility&lt;/strong&gt;: Used in a variety of applications, from residential homes and commercial buildings to large industrial substations, overhead power lines, and communication lines.&lt;/span&gt;&lt;span class=&quot;uJ19be notranslate&quot; data-wiz-uids=&quot;JQ2klf_26,JQ2klf_27,JQ2klf_28&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;vKEkVd&quot; data-animation-atomic=&quot;&quot; data-sae=&quot;&quot;&gt;&amp;nbsp;&lt;button class=&quot;rBl3me&quot; tabindex=&quot;0&quot; data-amic=&quot;true&quot; data-icl-uuid=&quot;20c235c3-7719-4338-adfd-a3926ba0cdca&quot; aria-label=&quot;View related links&quot; data-wiz-attrbind=&quot;disabled=JQ2klf_26_C5gNJc;class=JQ2klf_26_UpSNec;&quot; data-ved=&quot;2ahUKEwjGxP_lhYaRAxWmXWwGHQmOON4Qye0OegQIBxAE&quot;&gt;&lt;/button&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
