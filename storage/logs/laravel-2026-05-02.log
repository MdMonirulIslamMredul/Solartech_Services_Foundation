    \"<span class=sf-dump-key>short_description</span>\" => \"<span class=sf-dump-str title=\"166 characters\">Strengthen rural economy and improving livelihood through clean tech product and interactive service delivery that brings in organizational growth and sustainability.</span>\"
    \"<span class=sf-dump-key>banner_img</span>\" => \"<span class=sf-dump-str title=\"20 characters\">1763803913banner.gif</span>\"
